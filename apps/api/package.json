{
  "name": "@my-fit-track/api",
  "version": "0.0.0",
  "private": true,
  "description": "My Fit Tracker HTTP API",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@my-fit-track/contracts": "*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@testcontainers/postgresql": "^11.12.0",
    "prisma": "6.19.3",
    "testcontainers": "^11.12.0",
    "vitest": "^4.1.11"
  }
}
