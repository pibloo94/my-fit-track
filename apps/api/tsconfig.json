{
  "extends": "@my-fit-track/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2023",
    "lib": ["es2023"],
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.mts"],
  "exclude": ["src/**/__fixture_*__/**", "src/**/__fixture_*__.ts"]
}
