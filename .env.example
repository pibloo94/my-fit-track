# Copy to .env for local runs. Production must set every value that has no
# safe default — the process refuses to boot on a missing required variable.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_VERSION=dev
LOG_LEVEL=info

# Comma-separated browser origins. Capacitor origins are always appended.
# Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:4200

# Global ceiling. Auth endpoints will use a tighter limit in phase 2.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# Required in production. Development defaults to the Docker Compose database.
# Prisma CLI (migrate) reads `apps/api/.env` — copy apps/api/.env.example there.
DATABASE_URL=postgresql://myfittrack:myfittrack@localhost:5432/myfittrack?schema=public

# Optional. Shared with the Cloudflare Pages proxy Function (at least 32 characters).
# When a request carries it, the proxy's forwarded client address is trusted for
# rate limiting. Leave unset locally: the Angular dev-server proxy does not send it.
# API_PROXY_SECRET=

# Staging (Koyeb, ADR-015): NODE_ENV=production, PORT=3000, DATABASE_URL from Neon
# (direct connection), CORS_ORIGINS=https://my-fit-track-staging.pages.dev and the
# same API_PROXY_SECRET as the Pages project. See README, "Deployment".
